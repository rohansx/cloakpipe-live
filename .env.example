# Copy to .env and fill in to power the runtime agent with the OpenAI API.
# If OPENAI_API_KEY is unset, the app falls back to the deterministic scripted
# agent — the demo works identically either way, because the trust layer
# (detection, policy, ledger) is deterministic regardless of the agent.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Port the server listens on (also serves the built frontend in production).
# PORT=8787

# Optional: key used to derive tokens in the vault (any stable string).
# CLOAKPIPE_VAULT_KEY=change-me
